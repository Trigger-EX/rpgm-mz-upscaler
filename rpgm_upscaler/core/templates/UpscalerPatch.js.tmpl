/*:
 * @target MZ
 * @plugindesc Generated by RPGM Upscaler: adapts engine pixel metrics to upscaled assets (best effort).
 * @author rpgm-upscaler
 *
 * @help Do not edit. Generated for a world scale of x__N_TEXT__ (target __TW__x__TH__).
 * Every patch is feature-detected; problems are logged to the console as [UpscalerPatch].
 */
(() => {
"use strict";
try {
const CFG = __CONFIG__;
const N = CFG.n, OX = CFG.offset[0], OY = CFG.offset[1];
const TAG = "[UpscalerPatch]";
const isMZ = typeof Utils !== "undefined" && Utils.RPGMAKER_NAME === "MZ";
const warn = (m) => console.warn(TAG, m);
const R = (v) => Math.round(v * N);
const src = (cls, name) => (cls && cls.prototype && typeof cls.prototype[name] === "function") ? String(cls.prototype[name]) : "";

function scaleRet(cls, name) {
    if (!src(cls, name)) { warn("missing method " + name); return; }
    const orig = cls.prototype[name];
    cls.prototype[name] = function () {
        const v = orig.apply(this, arguments);
        return typeof v === "number" ? R(v) : v;
    };
}
function scaleStatic(cls, props) {
    for (const p of props) {
        const d = cls && Object.getOwnPropertyDescriptor(cls, p);
        if (d && d.get) {                     // MZ 1.9+: getters that read $dataSystem, which does not exist yet
            const g = d.get;
            Object.defineProperty(cls, p, { ...d, get() { return R(g.call(this)); } });
        } else if (cls && typeof cls[p] === "number") cls[p] = R(cls[p]);
        else warn("missing static " + p);
    }
}
function wrapArgs(cls, name, fn) {
    if (!src(cls, name)) { warn("missing method " + name); return; }
    const orig = cls.prototype[name];
    cls.prototype[name] = function () { return orig.apply(this, fn.apply(this, arguments)); };
}

// ---- screen size (MV; MZ reads System.json) -------------------------------------------------
if (!isMZ && typeof SceneManager !== "undefined") {
    SceneManager._screenWidth = CFG.target[0];
    SceneManager._screenHeight = CFG.target[1];
    SceneManager._boxWidth = CFG.ui[0];
    SceneManager._boxHeight = CFG.ui[1];
}

// ---- tiles ----------------------------------------------------------------------------------
if (!isMZ) { scaleRet(Game_Map, "tileWidth"); scaleRet(Game_Map, "tileHeight"); }
for (const [cls, name] of [[Game_CharacterBase, "shiftY"], [Game_CharacterBase, "jumpHeight"], [Game_Vehicle, "maxAltitude"]]) {
    if (cls) scaleRet(cls, name);
}
if (src(Game_CharacterBase, "refreshBushDepth")) {
    const o = Game_CharacterBase.prototype.refreshBushDepth;
    Game_CharacterBase.prototype.refreshBushDepth = function () {
        o.apply(this, arguments);
        if (this._bushDepth > 0) this._bushDepth = R(12);
    };
}

// ---- tilemap texture limits (MZ renderer packs sheets into fixed-size textures) ---------------
if (isMZ && CFG.texMult > 1 && typeof Tilemap !== "undefined") { // MV: js/libs/pixi-tilemap.js is patched on disk
    let patched = 0;
    for (const holder of [Tilemap, Tilemap.Renderer, Tilemap.Layer]) {
        if (!holder) continue;
        for (const target of [holder, holder.prototype]) {
            if (!target) continue;
            for (const key of Object.getOwnPropertyNames(target)) {
                const d = Object.getOwnPropertyDescriptor(target, key);
                if (!d || typeof d.value !== "function" || key === "constructor") continue;
                const s = String(d.value);
                if (!/\b(1024|2048)\b/.test(s)) continue;
                try {
                    const t = s.replace(/\b1024\b/g, String(1024 * CFG.texMult)).replace(/\b2048\b/g, String(2048 * CFG.texMult));
                    const f = s.startsWith("function") || s.startsWith("class") ? (0, eval)("(" + t + ")") : (0, eval)("({" + t + "})")[key];
                    target[key] = f; patched++;
                } catch (e) { warn("tilemap rewrite failed for " + key + ": " + e); }
            }
        }
    }
    console.info(TAG, "tilemap functions rewritten:", patched, "(texture multiplier x" + CFG.texMult + ")");
}

// ---- icons / faces ---------------------------------------------------------------------------
if (isMZ && typeof ImageManager !== "undefined") scaleStatic(ImageManager, ["iconWidth", "iconHeight", "faceWidth", "faceHeight"]);
else if (typeof Window_Base !== "undefined") scaleStatic(Window_Base, ["_iconWidth", "_iconHeight", "_faceWidth", "_faceHeight"]);

// ---- fonts and window metrics ----------------------------------------------------------------
if (typeof Window_Base !== "undefined") {
    Window_Base.prototype.makeFontBigger = function () { if (this.contents.fontSize <= R(96)) this.contents.fontSize += R(12); };
    Window_Base.prototype.makeFontSmaller = function () { if (this.contents.fontSize >= R(24)) this.contents.fontSize -= R(12); };
    scaleRet(Window_Base, "lineHeight");
    if (isMZ) {
        scaleRet(Window_Base, "itemPadding"); scaleRet(Game_System, "windowPadding");
        scaleRet(Window_Selectable, "colSpacing"); scaleRet(Window_Selectable, "rowSpacing");
    } else {
        for (const m of ["standardPadding", "textPadding", "standardFontSize"]) scaleRet(Window_Base, m);
        scaleRet(Window_Selectable, "spacing");
        for (const w of [Window_Gold, Window_MenuCommand, Window_TitleCommand, Window_PartyCommand, Window_ActorCommand]) {
            if (w) scaleRet(w, "windowWidth");
        }
        if (/gaugeBackColor/.test(src(Window_Base, "drawGauge"))) {
            Window_Base.prototype.drawGauge = function (x, y, width, rate, color1, color2) {
                const fillW = Math.floor(width * rate), gy = y + this.lineHeight() - R(8), h = R(6);
                this.contents.fillRect(x, gy, width, h, this.gaugeBackColor());
                this.contents.gradientFillRect(x, gy, fillW, h, color1, color2);
            };
        }
    }
}
if (typeof Bitmap !== "undefined") {
    const o = Bitmap.prototype.initialize;
    Bitmap.prototype.initialize = function () { o.apply(this, arguments); this.outlineWidth = Math.max(1, R(3)); };
}
if (isMZ) {
    if (typeof Sprite_Gauge !== "undefined") for (const m of ["bitmapWidth", "bitmapHeight", "gaugeHeight"]) scaleRet(Sprite_Gauge, m);
    if (typeof Sprite_Button !== "undefined") for (const m of ["blockWidth", "blockHeight"]) scaleRet(Sprite_Button, m);
    if (src(Sprite_Timer, "createBitmap")) {   // MZ draws the timer into a fixed 96x48 bitmap (no bitmapWidth hooks exist)
        Sprite_Timer.prototype.createBitmap = function () {
            this.bitmap = new Bitmap(R(96), R(48));
            this.bitmap.fontFace = this.fontFace();
            this.bitmap.fontSize = this.fontSize();
            this.bitmap.outlineColor = ColorManager.outlineColor();
        };
    }
    scaleRet(Scene_MenuBase, "buttonAreaHeight"); scaleRet(Scene_MenuBase, "mainCommandWidth");
} else if (src(Sprite_Timer, "createBitmap")) {
    Sprite_Timer.prototype.createBitmap = function () { this.bitmap = new Bitmap(R(96), R(48)); this.bitmap.fontSize = R(32); };
}

// ---- hard-coded layout literals in core screens ----------------------------------------------
if (/\b72\b/.test(src(Scene_Title, "drawGameTitle"))) {
    Scene_Title.prototype.drawGameTitle = function () {
        const x = R(20), y = Graphics.height / 4, maxWidth = Graphics.width - x * 2;
        const bmp = this._gameTitleSprite.bitmap;
        bmp.outlineColor = "black"; bmp.outlineWidth = R(8); bmp.fontSize = R(72);
        bmp.drawText($dataSystem.gameTitle, x, y, maxWidth, R(48), "center");
    };
}
if (!isMZ && /180/.test(src(Window_Base, "drawActorSimpleStatus")) && /200/.test(src(Window_Base, "drawActorSimpleStatus"))) {
    Window_Base.prototype.drawActorSimpleStatus = function (actor, x, y, width) {
        const lh = this.lineHeight(), x2 = x + R(180), width2 = Math.min(R(200), width - R(180) - this.textPadding());
        this.drawActorName(actor, x, y);
        this.drawActorLevel(actor, x, y + lh * 1);
        this.drawActorIcons(actor, x, y + lh * 2);
        this.drawActorClass(actor, x2, y);
        this.drawActorHp(actor, x2, y + lh * 1, width2);
        this.drawActorMp(actor, x2, y + lh * 2, width2);
    };
}
if (!isMZ) {
    for (const [name, def] of [["drawActorHp", 186], ["drawActorMp", 186], ["drawActorTp", 96]]) {
        if (!src(Window_Base, name)) continue;
        const o = Window_Base.prototype[name];
        Window_Base.prototype[name] = function (actor, x, y, width) { return o.call(this, actor, x, y, width || R(def)); };
    }
}

// ---- sprite sheets with literal cell sizes ---------------------------------------------------
if (/\b48\b/.test(src(Sprite_Balloon, "updateFrame"))) {
    Sprite_Balloon.prototype.updateFrame = function () {
        const w = R(48), h = R(48);
        this.setFrame(this.frameIndex() * w, (this._balloonId - 1) * h, w, h);
    };
}
if (/\b96\b/.test(src(Sprite_StateOverlay, "updateFrame"))) {
    Sprite_StateOverlay.prototype.updateFrame = function () {
        const w = R(96), h = R(96);
        this.setFrame(this._pattern * w, (this._overlayIndex - 1) * h, w, h);
    };
}
if (/\b96\b/.test(src(Sprite_Weapon, "updateFrame")) && /\b64\b/.test(src(Sprite_Weapon, "updateFrame"))) {
    Sprite_Weapon.prototype.updateFrame = function () {
        const index = (this._weaponImageId - 1) % 12, w = R(96), h = R(64);
        this.setFrame((Math.floor(index / 6) * 3 + this._pattern) * w, Math.floor(index % 6) * h, w, h);
    };
}
if (!isMZ && /192/.test(src(Sprite_Animation, "updateCellSprite"))) {
    const o = Sprite_Animation.prototype.updateCellSprite;
    Sprite_Animation.prototype.updateCellSprite = function (sprite, cell) {
        o.apply(this, arguments);
        const p = cell[0];
        if (p >= 0) {
            sprite.setFrame((p % 5) * R(192), Math.floor((p % 100) / 5) * R(192), R(192), R(192));
            sprite.x = cell[1] * N; sprite.y = cell[2] * N;
        }
    };
}
if (isMZ && src(Sprite_Animation, "updateEffectGeometry")) {
    const o = Sprite_Animation.prototype.updateEffectGeometry;
    Sprite_Animation.prototype.updateEffectGeometry = function () {
        o.apply(this, arguments);
        if (this._handle && this._animation && typeof this._handle.setScale === "function") {
            const s = (this._animation.scale / 100) * N;
            this._handle.setScale(s, s, s);
        }
    };
}

// Pictures must live in plain screen space: some engine versions give the container a pivot equal to
// its frame offset (MV) or a positional offset (MZ), which would shift pictures by the UI centering.
if (typeof Spriteset_Base !== "undefined" && src(Spriteset_Base, "createPictures")) {
    const o = Spriteset_Base.prototype.createPictures;
    Spriteset_Base.prototype.createPictures = function () {
        o.apply(this, arguments);
        const c = this._pictureContainer;
        if (c) {
            if (typeof c.setFrame === "function") c.setFrame(0, 0, Graphics.width, Graphics.height);
            c.x = 0; c.y = 0;
        }
    };
}

// ---- screen-pixel coordinates authored for the original resolution -------------------------------
wrapArgs(Game_Picture, "show", function (name, origin, x, y) {
    const a = Array.from(arguments); a[2] = Math.round(x * N + OX); a[3] = Math.round(y * N + OY); return a;
});
wrapArgs(Game_Picture, "move", function (origin, x, y) {
    const a = Array.from(arguments); a[1] = Math.round(x * N + OX); a[2] = Math.round(y * N + OY); return a;
});
wrapArgs(Game_Enemy, "setup", function (id, x, y) {
    const a = Array.from(arguments); a[1] = Math.round(x * N + OX); a[2] = Math.round(y * N + OY); return a;
});
wrapArgs(Game_Screen, "startZoom", function (x, y) {
    const a = Array.from(arguments); a[0] = Math.round(x * N + OX); a[1] = Math.round(y * N + OY); return a;
});
scaleRet(Game_Screen, "shake");
wrapArgs(Sprite_Battler, "startMove", function (x, y) {
    const a = Array.from(arguments); a[0] = x * N; a[1] = y * N; return a;
});
if (src(Sprite_Actor, "setActorHome")) {
    const o = Sprite_Actor.prototype.setActorHome;
    Sprite_Actor.prototype.setActorHome = function () {
        const home = Sprite_Battler.prototype.setHome;
        this.setHome = (x, y) => home.call(this, Math.round(x * N + OX), Math.round(y * N + OY));
        try { return o.apply(this, arguments); } finally { delete this.setHome; }
    };
}

// ---- fixed pixel sizes that screens return as bare literals ------------------------------------
// `Window_Options.windowWidth() { return 400; }`, `statusWidth() { return 120; }`, MZ `slotNameWidth() { return 138; }` ... The
// methods patched above are already wrappers (not bare literals), so nothing is scaled twice; zeros and counts stay as they are.
{
    const NAME = /(Width|Height|Spacing|Padding|Margin)$/;
    const LITERAL = /^function\s*\([^)]*\)\s*\{\s*return\s+(\d+)\s*;?\s*\}$/;
    let scaled = 0;
    for (const key of Object.getOwnPropertyNames(globalThis)) {
        if (!/^(Window|Scene)_/.test(key)) continue;
        let cls;
        try { cls = globalThis[key]; } catch (e) { continue; }
        if (typeof cls !== "function" || !cls.prototype) continue;
        for (const m of Object.getOwnPropertyNames(cls.prototype)) {
            if (!NAME.test(m)) continue;
            const d = Object.getOwnPropertyDescriptor(cls.prototype, m);
            const mt = d && typeof d.value === "function" ? LITERAL.exec(String(d.value).trim()) : null;
            if (!mt || +mt[1] === 0) continue;
            const v = +mt[1];
            cls.prototype[m] = function () { return R(v); };
            scaled++;
        }
    }
    console.info(TAG, "fixed-size methods scaled:", scaled);
}

console.info(TAG, "loaded, world scale x" + N, isMZ ? "(MZ)" : "(MV)");
} catch (e) { console.error("[UpscalerPatch] aborted:", e); }
})();
